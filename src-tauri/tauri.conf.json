{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RunaWeb",
  "version": "0.1.0",
  "identifier": "com.m5devs.runaweb",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RunaWeb - Offline Web Game Player",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../public/icon-512.png",
      "../public/icon-192.png"
    ]
  }
}
